# ==========================================
# Server Configuration (Hostinger Deployment)
# ==========================================
PORT=5000
NODE_ENV=production
HOST=0.0.0.0

# Client / Domain URL
CLIENT_URL=https://yourdomain.com

# ==========================================
# Hostinger MySQL Database Credentials
# (Found in Hostinger hPanel -> Databases -> MySQL Databases)
# ==========================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=u123456789_dbuser
DB_PASSWORD=your_db_password
DB_NAME=u123456789_dbname

# ==========================================
# Real-Time Email Notifications (Nodemailer)
# ==========================================
# Admin email receiving application alerts:
ADMIN_EMAIL=24pca103@anjaconline.org

# Option A: Hostinger Webmail / Titan Mail SMTP:
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=admissions@yourdomain.com
# SMTP_PASS=your_email_password
# SMTP_FROM="Global Nagas Institute" <admissions@yourdomain.com>

# Option B: Gmail SMTP (Use 16-character Google App Password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=yourgmail@gmail.com
# SMTP_PASS=your_16_char_app_password
# SMTP_FROM="Global Nagas Institute" <yourgmail@gmail.com>
